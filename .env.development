# Local development: the app talks to the Firebase emulators under a demo project. No accounts, no secrets.
# Start the emulators with `npm run emulators` and seed them with `npm run seed`.
# Override any value in .env.development.local (git-ignored). Every variable is documented in .env.example.
VITE_FIREBASE_CONFIG={"apiKey":"demo-api-key","authDomain":"demo-seed-app.firebaseapp.com","projectId":"demo-seed-app","appId":"demo-app-id"}
VITE_FIRESTORE_DATABASE_ID=(default)
VITE_USE_EMULATORS=true
VITE_E2E_LOGIN=true
