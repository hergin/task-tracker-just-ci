# Every environment variable this project uses, documented, with no real values.
#
# Local development needs none of these: .env.development (committed) points the app at the Firebase
# emulators with a demo project. Put personal overrides in .env.development.local (git-ignored).
#
# Vite exposes only VITE_-prefixed variables to the browser and inlines them at build time,
# so every deployment is built with its own values.

# --- App (build time) ---

# Firebase web app config as one line of JSON (Firebase console > Project settings > Your apps).
# Not a secret: it ships in the browser bundle.
VITE_FIREBASE_CONFIG={"apiKey":"...","authDomain":"<project-id>.firebaseapp.com","projectId":"<project-id>","appId":"..."}

# Firestore database id, usually "(default)".
VITE_FIRESTORE_DATABASE_ID=(default)

# "true" connects to the local emulators (Auth 127.0.0.1:9099, Firestore 127.0.0.1:8080).
VITE_USE_EMULATORS=false

# "true" includes the test sign-in form. Local and test builds only, never production.
VITE_E2E_LOGIN=false

# --- Acceptance tests (npm run test:e2e) ---

# The app the tests drive. Defaults to the local dev server, http://localhost:5173.
BASE_URL=

# Password of the test account e2e-owner@e2e.test in a deployment. Needed only when BASE_URL points at one.
# The local emulators always use local-e2e-password. Secret.
E2E_PASSWORD=

# --- Preview deployments (scripts/preview.ts) ---
#
# Each open pull request gets its own Hosting channel in the staging project, so the change can be looked at
# before it is merged; the channel goes when the pull request closes, and expires by itself after 30 days.
# In CI these come from the repository's variables and secrets; locally, put them in .env.staging.local.
#
# They all name staging. A deploy runs against whichever project these point at, and the script refuses to run
# if staging and production are the same one.

# The Firebase project the previews go in. Not production.
FIREBASE_PROJECT_ID_STAGING=

# The production project, named only so the script can refuse to deploy a preview into it.
FIREBASE_PROJECT_ID_PROD=

# Staging's own web app config, one line of JSON, as VITE_FIREBASE_CONFIG above. The preview is built with it.
FIREBASE_WEB_CONFIG_STAGING=

# A service account key for the staging project, as one line of JSON, with rights to deploy Hosting.
# In CI this is the FIREBASE_SERVICE_ACCOUNT_STAGING secret, written to a file the Firebase CLI is pointed at.
# Locally, point GOOGLE_APPLICATION_CREDENTIALS at that file yourself. Secret.
GOOGLE_APPLICATION_CREDENTIALS=
